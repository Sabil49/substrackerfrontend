{
  "expo": {
    "name": "Substracker",
    "slug": "substracker-myzoapp",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "substracker",
    "userInterfaceStyle": "automatic",
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.sabil.subscriptiontracker", "infoPlist": { "ITSAppUsesNonExemptEncryption": false } },
    "android": {
      "package": "com.sabil.subscriptiontracker",
      "versionCode": 7,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F5B65A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "useProguard": true,
            "minSdkVersion": 24
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expoProjectId": "f51bbbb6-2cd9-45c1-84b1-4e927df82404",
      "eas": {
        "projectId": "f51bbbb6-2cd9-45c1-84b1-4e927df82404"
      }
    },
    "owner": "myzoapp"
  }
}
