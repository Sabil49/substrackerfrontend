{
  "expo": {
    "name": "Substracker",
    "slug": "substracker-myzoapp",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "substracker",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sabil.subscriptiontracker",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Substracker uses your photo library only when you choose a receipt or subscription screenshot to import.",
        "NSCameraUsageDescription": "Substracker uses your camera only when you choose to photograph a receipt or subscription screenshot to import."
      },
      "buildNumber": "45"
    },
    "android": {
      "package": "com.sabil.subscriptiontracker",
      "versionCode": 7,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F5B65A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B10",
          "dark": {
            "backgroundColor": "#0B0B10"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "useProguard": true,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.976201476870-eprci5h7q38ooru4ensavkqf3j5g4fop"
        }
      ],
      "expo-apple-authentication",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a14e9db-1796-4036-93a6-6c02d9898997"
      }
    },
    "owner": "myzoapp8780"
  }
}
